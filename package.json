{
  "name": "cloudflare-wiki",
  "version": "0.1.0",
  "description": "Cloudflare-native bilingual Markdown wiki for emby.wiki, with Wiki.js 3-style UI, single-admin CMS, and GitHub Actions deployment.",
  "scripts": {
    "dev": "npm run db:local && vite --host 127.0.0.1",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "preview": "vite preview --host 127.0.0.1",
    "cf:types": "wrangler types",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "npm run cf:types && tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "test": "vitest run && node --test tests/*.test.mjs",
    "build": "vite build",
    "smoke": "node scripts/smoke-test.mjs",
    "test:preview": "node scripts/preview-smoke.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run test:preview",
    "deploy:test": "node scripts/deploy-test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacklilyhello/cloudflare-wiki.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/jacklilyhello/cloudflare-wiki/issues"
  },
  "homepage": "https://github.com/jacklilyhello/cloudflare-wiki#readme",
  "dependencies": {
    "dompurify": "3.4.15",
    "hast-util-to-text": "4.0.2",
    "mermaid": "11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/vitest-plugin": "1.1.13",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
